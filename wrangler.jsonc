{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "form",
  "main": ".open-next/worker.js",
  "workers_dev": false,
  // Cloudflare manages the DNS record and cert for a custom domain route.
  "routes": [{ "pattern": "form.magana.marketing", "custom_domain": true }],
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
